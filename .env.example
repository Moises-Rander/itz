# =============================================================================
# ITZ — variáveis de ambiente (copie para .env e ajuste os valores)
# NUNCA versione o arquivo .env com valores reais.
# =============================================================================

# --- Django ---
# Gere uma chave nova em produção (ex.: python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
# Lista separada por vírgula (ex.: api.itzait.com.br). Vazio em dev.
ALLOWED_HOSTS=

# --- Banco de dados ---
# Em produção, a connection string do Neon (Postgres). Em dev, se vazio, usa SQLite.
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/itz?sslmode=require

# Origens confiáveis para o Admin (CSRF) sob HTTPS. Ex.: https://api.itzait.com.br,https://itzait.com.br
CSRF_TRUSTED_ORIGINS=

# URLs base usadas nos links dos emails
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Origens permitidas para CORS (front-end). Lista separada por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email / SMTP ---
# Em desenvolvimento, use o backend de console (imprime o email no terminal):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Em produção, use o backend SMTP nativo do Django:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seuprovedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=zenaldooliveira67@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-ou-app-password
EMAIL_USE_TLS=True
# Nome exibido no campo "De":
DEFAULT_FROM_EMAIL=Instituto de Teologia Zait <zenaldooliveira67@gmail.com>
# Endereço do Admin que recebe notificações internas (matrículas a validar, etc.):
ADMIN_EMAIL=zenaldooliveira67@gmail.com
# Reitor: recebe um email com os dados do aluno a cada nova matrícula
# (se vazio, usa o ADMIN_EMAIL):
REITOR_EMAIL=

# --- Dados institucionais (cabeçalho/rodapé dos emails) ---
INSTITUICAO_NOME=Instituto de Teologia Zait
INSTITUICAO_CONTATO_EMAIL=zenaldooliveira67@gmail.com
INSTITUICAO_CONTATO_TELEFONE=(98) 98833-9224
# URL pública do logo (opcional); se vazio, exibe o nome como placeholder:
INSTITUICAO_LOGO_URL=

# --- Asaas (pagamentos) ---
# ASAAS_FAKE=True usa um cliente simulado (sem rede), ideal para dev/testes.
# Em produção: ASAAS_FAKE=False e ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_FAKE=True
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=troque-este-token-do-webhook

# --- Storage de mídia (produção) ---
# USE_S3=True guarda as imagens enviadas num bucket S3-compatível (ex.: Cloudflare R2).
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=itz-media   # bucket PÚBLICO (imagens)
# Endpoint do R2 (ex.: https://<accountid>.r2.cloudflarestorage.com) ou vazio p/ AWS S3
AWS_S3_ENDPOINT_URL=
# Domínio público SÓ do bucket de imagens (ex.: cdn.itzait.com.br ou pub-xxxx.r2.dev)
AWS_S3_CUSTOM_DOMAIN=

# --- Segurança / Observabilidade (produção) ---
# SECURE_SSL_REDIRECT=True   # já é o padrão quando DEBUG=False
SENTRY_DSN=
# Limite de tentativas por IP no checkout (freia teste de cartões em massa)
THROTTLE_CHECKOUT=10/hour
THROTTLE_SIMULAR=60/min
# Proxies na frente do Django — para achar o IP real (no Cloud Run: 1). Vazio em dev.
NUM_PROXIES=

# --- Regras da matrícula ---
MAX_PARCELAS=12
RESERVA_MINUTOS=30
SEDE_ENDERECO=Rua Transjordânia, 235 - Recanto Vinhais, São Luís - MA, 65070-616
